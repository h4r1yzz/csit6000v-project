# Copy to backend/.env if you prefer a file for local app settings.
# Planning, agents and chat require a reachable model. Without it they return HTTP 503.
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-27b
QWEN_TIMEOUT_SECONDS=45
# Generic OpenAI-compatible chat endpoint, including /v1 if your provider requires it.
# LLM_BASE_URL takes precedence over QWEN_BASE_URL.
LLM_BASE_URL=
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
FITPILOT_TIMEZONE=Asia/Hong_Kong
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App database. Use a disposable PostgreSQL database for verification.
DATABASE_URL=
# Optional direct (unpooled) URL for schema setup; defaults to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Export TEST_DATABASE_URL in your shell when running the evaluation scripts.
