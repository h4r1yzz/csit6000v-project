# Copy to .env. uvicorn app.main:app --reload --env-file .env
# All optional: without a configured model, agents use labeled local rules.
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-27b
QWEN_TIMEOUT_SECONDS=45
# Generic OpenAI-compatible chat endpoint, including /v1 if your provider requires it.
# LLM_BASE_URL takes precedence over QWEN_BASE_URL.
LLM_BASE_URL=
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
# Leave DB path unset to use database/fitpilot.db.
# FITPILOT_DB_PATH=/absolute/path/to/fitpilot.db
FITPILOT_TIMEZONE=Asia/Hong_Kong
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon pooled Postgres URL (server only); unset for local SQLite.
DATABASE_URL=
