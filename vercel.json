{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend && python scripts/vercel_build.py",
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/.venv/**,backend/tests/**,frontend/node_modules/**,frontend/src/**,frontend/public/**,frontend/dist/**,public/**,database/*.db*,Samples/**,.git/**}"
    }
  },
  "rewrites": [{ "source": "/", "destination": "/index.html" }]
}
